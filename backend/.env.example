# Copy to backend/.env and fill in. Never commit .env.

NODE_ENV=
PORT=
FRONTEND_URL=

# Shared team MongoDB Atlas cluster (team leader shares it privately)
MONGODB_URI=

# Auth — use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MIN=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12

# Cookies (Secure works on http://localhost in modern browsers)
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=

# Uploads (GEN-08)
UPLOAD_DIR=

# PAY-04 single platform currency
PLATFORM_CURRENCY=

# ACC-18 seeded admin (created by `npm run seed`)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: where `npm run seed` reads reference JSON files
SEED_DATA_DIR=seed-data

# Person 3 — Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Person 5 — FXRatesAPI
FXRATES_API_URL=
FXRATES_API_KEY=